{
  "manifest_version": 3,
  "name": "IntentLock",
  "version": "2.1",
  "description": "Reminds me who I am and my goals, bypassing study sites with a built-in Pomodoro timer.",
  "permissions": ["storage", "activeTab", "notifications", "alarms", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}